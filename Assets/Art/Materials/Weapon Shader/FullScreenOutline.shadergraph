        },
        {
            "m_Id": "8015c6e6b48b4973b537456dd88708db"
        },
        {
            "m_Id": "f3aa1a8749994d71a4e0cfbb709f7be1"
        },
        {
            "m_Id": "7a3e8cae4e684c0d9084cf9ed33f5aa8"
        },
        {
            "m_Id": "e3fd35273ea14b85b26b6b5bb48c86c8"
        },
        {
            "m_Id": "13e424b8a68e4de0a70273b989e912b2"
        },
        {
            "m_Id": "2a0742547955498897d9b0243008355f"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "GetCrossSampleUVs",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "UVOriginal = UV.xy;\n\nfloat2 offset = TexelSize * OffsetMultiplier;\n\nUVTopRight    = UV.xy + float2( offset.x,  offset.y);\nUVBottomLeft  = UV.xy + float2(-offset.x, -offset.y);\nUVTopLeft     = UV.xy + float2(-offset.x,  offset.y);\nUVBottomRight = UV.xy + float2( offset.x, -offset.y);"
}

