    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "PickOutlineColor",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "float4 chosen = Center;\nif (TopRight.a > chosen.a) chosen = TopRight;\nif (BottomLeft.a > chosen.a) chosen = BottomLeft;\nif (TopLeft.a > chosen.a) chosen = TopLeft;\nif (BottomRight.a > chosen.a) chosen = BottomRight;\nColor = chosen.rgb;\nCoverage = chosen.a;"
}

