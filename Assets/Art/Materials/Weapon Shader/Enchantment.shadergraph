{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "54543e7d30a544ca868c129775039cb6",
    "m_Group": {
        "m_Id": "135baac7e99a45418cebb734d1d744b3"
    },
    "m_Name": "GetMainLight (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -666.8571166992188,
            "y": -1685.142822265625,
            "width": 232.57135009765626,
            "height": 351.4285888671875
        }
    },
    "m_Slots": [
        {
            "m_Id": "c8c009c1b47d419bb54795034968c545"
        },
        {
            "m_Id": "b7440bd307af4e17a1e972a90c78e5f2"
        },
        {
            "m_Id": "36e3c01b44fa46c9a9b0e43d60e90133"
        },
        {
            "m_Id": "d241a9230df54887840ef765361ba0d0"
        },
        {
            "m_Id": "a43e24c6798b4b06b8608553a12d1c29"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": true,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 0,
    "m_FunctionName": "GetMainLight",
    "m_FunctionSource": "66ab2c2622b0054428166baa811d90c1",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "void MainLight_float(float3 WorldPos, out float3 Direction, out float3 Color, out float DistanceAtten, out float ShadowAtten)\r\n{\r\n#if SHADERGRAPH_PREVIEW\r\n    Direction = float3(0.5, 0.5, 0);\r\n    Color = 1;\r\n    DistanceAtten = 1;\r\n    ShadowAtten = 1;\r\n#else\r\n#if SHADOWS_SCREEN\r\n    float4 clipPos = TransformWorldToHClip(WorldPos);\r\n    float4 shadowCoord = ComputeScreenPos(clipPos);\r\n#else\r\n    float4 shadowCoord = TransformWorldToShadowCoord(WorldPos);\r\n#endif\r\n    Light mainLight = GetMainLight(shadowCoord);\r\n    Direction = mainLight.direction;\r\n    Color = mainLight.color;\r\n    DistanceAtten = mainLight.distanceAttenuation;\r\n    ShadowAtten = mainLight.shadowAttenuation;\r\n#endif\r\n}"
}

