    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "HashPosition",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "float2 p = Position.xz;\nOffset.x = frac(sin(dot(p, float2(12.9898, 78.233))) * 43758.5453);\nOffset.y = frac(sin(dot(p, float2(39.3468, Position.y))) * 43758.5453);"
}

