{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "a5876f22dc3a437d80165b88d8b408ce",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "GetMainLight (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -1411.4285888671875,
            "y": -84.57140350341797,
