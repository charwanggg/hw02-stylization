    "m_FunctionName": "HashPosition",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "float2 p = Position.xz;\nOffset.x = frac(sin(dot(p, float2(12.9898, 78.233))) * 43758.5453);\nOffset.y = frac(sin(dot(p, float2(39.3468, 11.135))) * 43758.5453);"
}

